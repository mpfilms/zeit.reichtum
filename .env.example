# Kopiere diese Datei nach .env und trage deinen Schlüssel aus Google AI Studio ein.
# .env wird nicht ins Git übernommen.
GEMINI_API_KEY=
# Optional: Standard-Modell (gemini-pro | gemini-flash | imagen-4 | volle Modell-ID)
# Verfügbare Modelle: python3 scripts/render_images.py --list-models
# Bilder brauchen ein Projekt mit aktivierter Abrechnung (Free Tier: Bild-Kontingent 0).
# GEMINI_IMAGE_MODEL=gemini-pro
